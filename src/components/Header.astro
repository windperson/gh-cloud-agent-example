---
import Menu from '../assets/icons/menu.svg';
---

<header class="bg-blue-500 dark:bg-blue-700 text-white p-4 shadow-md transition-colors duration-300">
  <div class="container mx-auto flex flex-wrap justify-between items-center gap-2 pl-4 pr-4">
    <div class="flex items-center">
      <div class="relative group">
        <button id="menu-toggle" class="focus:outline-none focus:ring-2 focus:ring-white focus:ring-offset-2 focus:ring-offset-blue-500 rounded mr-4" aria-label="Toggle menu" aria-expanded="false" aria-controls="menu">
          <Menu class="h-6 w-6" aria-hidden="true" />
        </button>
        <nav id="menu" aria-label="Main" class="hidden absolute left-0 mt-2 w-48 bg-white dark:bg-slate-800 text-slate-800 dark:text-white rounded shadow-lg z-10 transition-colors duration-300">
          <ul class="py-1">
            <li><a href="/" class="block px-4 py-2 hover:bg-slate-100 dark:hover:bg-slate-700">Home</a></li>
            <li><a href="/about" class="block px-4 py-2 hover:bg-slate-100 dark:hover:bg-slate-700">About</a></li>
          </ul>
        </nav>
      </div>
      <div class="text-xl font-bold"><a href="/" class="hover:underline">Tailspin Toys</a></div>
    </div>
    <div class="flex flex-wrap items-center gap-2">
      <button
        id="theme-toggle"
        type="button"
        class="rounded bg-blue-900 px-3 py-2 text-sm font-medium hover:bg-blue-800 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-yellow-300 focus-visible:ring-offset-2 focus-visible:ring-offset-blue-700"
        aria-label="Light mode"
        aria-pressed="false"
        data-testid="theme-toggle"
      >
        Light mode
      </button>
      <button
        id="high-contrast-toggle"
        type="button"
        class="rounded bg-blue-900 px-3 py-2 text-sm font-medium hover:bg-blue-800 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-yellow-300 focus-visible:ring-offset-2 focus-visible:ring-offset-blue-700"
        aria-label="High contrast mode"
        aria-pressed="false"
        data-testid="high-contrast-toggle"
      >
        High contrast
      </button>
    </div>
  </div>
</header>

<script>
  // Toggle menu visibility when hamburger is clicked
  const menuToggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('menu');
  
  if (menuToggle && menu) {
    menuToggle.addEventListener('click', () => {
      menu.classList.toggle('hidden');
      const isExpanded = !menu.classList.contains('hidden');
      menuToggle.setAttribute('aria-expanded', String(isExpanded));
      if (isExpanded) {
        const firstLink = menu.querySelector('a');
        if (firstLink) firstLink.focus();
      }
    });
    
    // Close menu when clicking outside
    document.addEventListener('click', (event) => {
      const target = event.target;
      const isClickInside = target instanceof Node && (menuToggle.contains(target) || menu.contains(target));
      if (!isClickInside && !menu.classList.contains('hidden')) {
        menu.classList.add('hidden');
        menuToggle.setAttribute('aria-expanded', 'false');
      }
    });

    // Close menu with Escape key and return focus to toggle button
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && !menu.classList.contains('hidden')) {
        menu.classList.add('hidden');
        menuToggle.setAttribute('aria-expanded', 'false');
        menuToggle.focus();
      }
    });
  }

  const themeToggle = document.getElementById('theme-toggle');
  if (themeToggle) {
    const isLightMode = document.documentElement.dataset.theme === 'light';
    themeToggle.setAttribute('aria-pressed', String(isLightMode));

    themeToggle.addEventListener('click', () => {
      const enableLightMode = document.documentElement.dataset.theme !== 'light';
      if (enableLightMode) {
        document.documentElement.dataset.theme = 'light';
      } else {
        delete document.documentElement.dataset.theme;
      }
      themeToggle.setAttribute('aria-pressed', String(enableLightMode));

      try {
        localStorage.setItem('theme', enableLightMode ? 'light' : 'dark');
      } catch {
        // The current page still updates when browser storage is unavailable.
      }
    });
  }

  const contrastToggle = document.getElementById('high-contrast-toggle');
  if (contrastToggle) {
    const isHighContrast = document.documentElement.dataset.highContrast === 'true';
    contrastToggle.setAttribute('aria-pressed', String(isHighContrast));

    contrastToggle.addEventListener('click', () => {
      const enableHighContrast = document.documentElement.dataset.highContrast !== 'true';
      document.documentElement.dataset.highContrast = String(enableHighContrast);
      contrastToggle.setAttribute('aria-pressed', String(enableHighContrast));

      try {
        localStorage.setItem('high-contrast', String(enableHighContrast));
      } catch {
        // The current page still updates when browser storage is unavailable.
      }
    });
  }
</script>